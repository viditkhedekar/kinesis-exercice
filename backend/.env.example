# Copy to .env for local (non-docker) runs. Docker Compose sets these directly.
# NEVER commit a real .env — every value below is a placeholder.

# --- Database (Neon in production) ---
# Local dev / docker-compose:
KINESIS_DATABASE_URL=postgresql+psycopg2://kinesis:kinesis@localhost:5432/kinesis
# Production (Neon): paste the pooled connection string from the Neon dashboard.
# postgres:// and postgresql:// are both accepted and normalised for psycopg2, and
# sslmode=require is added automatically for remote hosts.
# KINESIS_DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# --- Storage ---
# "auto" (default) uses Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are
# set and the local filesystem otherwise. Force with "supabase" or "filesystem".
KINESIS_STORAGE_BACKEND=auto
# Filesystem backend root. On Render this is EPHEMERAL and only used for the temp
# files the CV pipeline needs — durable storage is Supabase.
KINESIS_STORAGE_DIR=/data/kinesis

# --- Supabase Storage (videos + analysis artifacts) ---
# SERVER-SIDE ONLY. The service-role key bypasses row-level security and must never
# be sent to the browser or put in a NEXT_PUBLIC_* variable. The backend hands the
# frontend short-lived signed URLs instead.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=kinesis-media
# Lifetime (seconds) of the signed playback URLs handed to the browser.
KINESIS_SUPABASE_SIGNED_URL_TTL=3600

# --- Pose estimation performance (tune to trade speed vs accuracy) ---
# Model complexity: 0=lite (default, fastest), 1=full, 2=heavy (most accurate).
# Compare on your own clips with `python -m scripts.benchmark_pose <clip>`.
KINESIS_POSE_MODEL_COMPLEXITY=0
KINESIS_POSE_TARGET_FPS=5         # temporal downsample target
KINESIS_POSE_MAX_DIM=640          # downscale longest side before inference (~640x360)
KINESIS_POSE_DECODER=ffmpeg       # "ffmpeg" (fast, default) or "cv2" (force OpenCV)
KINESIS_POSE_FFMPEG_FAST_DECODE=true  # skip H.264 deblocking + fast downscale in ffmpeg
KINESIS_POSE_REUSE_MODEL=true     # reuse one landmarker per worker thread across requests
KINESIS_POSE_RUNNING_MODE=video   # "video" (tracking) or "image" (detect per frame)
KINESIS_POSE_NUM_THREADS=0        # CPU inference thread hint (0=default; honoured by MoveNet)
KINESIS_POSE_BACKEND=mediapipe    # "mediapipe" (33 landmarks) or "movenet" (17 kpts, faster)
